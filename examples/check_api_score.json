{
  "workflow_name": "check_api_score",
  "slug": "check-api-score",
  "description": "Check documentation quality score for a selected API",
  "inputs": [
    {
      "name": "api_name",
      "type": "string",
      "required": true
    }
  ],
  "steps": [
    {
      "id": "step_1",
      "type": "navigate",
      "url": "http://localhost:5500/api-scores.html",
      "description": "Open the API score checker"
    },
    {
      "id": "step_2",
      "type": "select",
      "selector_type": "label",
      "selector_value": "Select API",
      "option_value": "{{api_name}}",
      "description": "Choose the API to score"
    },
    {
      "id": "step_3",
      "type": "click",
      "selector_type": "role",
      "selector_value": "Check Score",
      "description": "Run the score check"
    },
    {
      "id": "step_4",
      "type": "wait",
      "duration_ms": 600,
      "description": "Wait for score results"
    },
    {
      "id": "step_5",
      "type": "extract_text",
      "selector_type": "test_id",
      "selector_value": "api-score",
      "output_key": "api_score",
      "description": "Read the API score"
    },
    {
      "id": "step_6",
      "type": "extract_text",
      "selector_type": "test_id",
      "selector_value": "issues-count",
      "output_key": "issues_count",
      "description": "Read the issue count"
    },
    {
      "id": "step_7",
      "type": "extract_text",
      "selector_type": "test_id",
      "selector_value": "last-checked",
      "output_key": "last_checked",
      "description": "Read the last checked timestamp"
    }
  ],
  "outputs": [
    {
      "name": "api_score",
      "type": "string"
    },
    {
      "name": "issues_count",
      "type": "string"
    },
    {
      "name": "last_checked",
      "type": "string"
    }
  ]
}
